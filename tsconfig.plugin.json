{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugin.tsbuildinfo",
    "target": "es2017",
    "lib": ["ES2017"],
    "typeRoots": ["./node_modules/@figma/plugin-typings", "./node_modules/@types"],
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/plugin", "src/types", "src/consts/pluginUiSize.ts"],
  "exclude": ["src/plugin/**/*.test.ts"]
}
